# Drishti Line Side Board runtime mode: unconfigured | mock | production
LSB_MODE=unconfigured

# Java SQL Server service
LSB_JAVA_URL=http://localhost:8080

# SQL Server connection used by setup, Excel import, and OEE entry APIs
LSB_DB_SERVER=
LSB_DB_PORT=1433
LSB_DB_NAME=
LSB_DB_USER=
LSB_DB_PASSWORD=
LSB_DB_ENCRYPT=true
LSB_DB_TRUST_SERVER_CERTIFICATE=true

# Python executable used by scripts/import_excel.py
LSB_PYTHON=python

# Go HTTP server
PORT=3001
