# Drishti Line Side Board runtime mode: unconfigured | mock | production
LSB_MODE=unconfigured

# MARS SQL Server — filled by setup wizard step 1
LSB_DB_SERVER=
LSB_DB_PORT=1433
LSB_DB_NAME=
LSB_DB_USER=
LSB_DB_PASSWORD=
LSB_DB_ENCRYPT=true
LSB_DB_TRUST_SERVER_CERTIFICATE=true

# PostgreSQL — OEE and 1x1 operational data store
DB_HOST=
DB_PORT=5432
DB_NAME=lsb_oee
DB_USER=
DB_PASS=

# Python executable used by scripts/import_excel.py
LSB_PYTHON=python

# Go HTTP server
PORT=3001

# Daily LLM health digest time in local server time (HH:MM)
DIGEST_TIME=06:00

# Log output file. Leave empty to log to stdout.
LOG_FILE=

# CORS — restrict to plant LAN subnet e.g. 192.168.10.0/24. Leave empty during development only.
CORS_SUBNET=
